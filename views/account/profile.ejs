<%- include('../partials/top') %>
<section class="wrap acct">
  <%- include('_nav', { active: 'profile' }) %>
  <div style="display:grid;gap:30px">
    <h1 class="h-section">Profile</h1>
    <form method="post" action="/account/profile" class="card form-grid">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label>Name</label><input name="name" value="<%= c.name %>" required></div>
      <div class="field"><label>Phone</label><input value="<%= c.phone %>" disabled></div>
      <div class="field full"><label>Email</label><input name="email" type="email" value="<%= c.email || '' %>"></div>
      <div class="field"><label>Default address</label><input name="address" value="<%= c.address || '' %>"></div>
      <div class="field"><label>Pincode</label><input name="pincode" value="<%= c.pincode || '' %>"></div>
      <div class="field full"><label>New password (optional)</label><input name="password" type="password" minlength="6" autocomplete="new-password"></div>
      <div class="full"><button class="btn">Save profile <span class="btn-dot"><%- icon('check') %></span></button></div>
    </form>
    <div class="card">
      <h2 class="h-card" style="margin-bottom:18px">Saved addresses</h2>
      <div class="order-list" style="margin-bottom:24px">
        <% addresses.forEach(a => { %>
        <div class="order-item" style="grid-template-columns:auto 1fr auto"><span class="oi-ic"><%- icon('home') %></span><div><b style="font-family:var(--f-body)"><%= a.label %></b><small><%= a.address %> — <%= a.pincode %></small></div>
          <form method="post" action="/account/addresses/<%= a.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-btn" aria-label="Delete"><%- icon('trash') %></button></form></div>
        <% }) %>
        <% if (!addresses.length) { %><p style="color:var(--muted)">No saved addresses yet.</p><% } %>
      </div>
      <form method="post" action="/account/addresses" class="form-grid">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label>Label</label><input name="label" placeholder="Home / Office"></div>
        <div class="field"><label>Pincode</label><input name="pincode"></div>
        <div class="field full"><label>Address</label><input name="address" required></div>
        <div class="field full"><label>Landmark</label><input name="landmark"></div>
        <div class="full"><button class="btn btn-ghost">Add address</button></div>
      </form>
    </div>
  </div>
</section>
<%- include('../partials/bottom') %>
