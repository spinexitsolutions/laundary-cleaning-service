<%- include('_top') %>
<div class="help">Enter a price to offer an item under a service. Leave a cell <b>empty</b> if that service doesn’t apply to the item. Add new services in <a href="/admin/services">Services</a> and new garments in <a href="/admin/items">Garments / Items</a>.</div>
<form method="post" action="/admin/pricing">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (kgServices.length) { %>
  <div class="card" style="margin-bottom:18px">
    <div class="card-h"><h2>Per-kg services</h2></div>
    <div class="card-b" style="display:flex;gap:18px;flex-wrap:wrap">
      <% kgServices.forEach(k => { %><div class="fld"><label><%= k.title %> (per kg)</label><input type="number" step="0.01" name="kg_<%= k.id %>" value="<%= k.price_per_kg %>" style="width:160px"></div><% }) %>
    </div>
  </div>
  <% } %>
  <div class="card">
    <div class="card-h"><h2>Per-item price matrix</h2><div class="sp"></div><input class="in" placeholder="Filter items…" style="width:200px" oninput="const q=this.value.toLowerCase();document.querySelectorAll('[data-iname]').forEach(r=>r.hidden=!r.dataset.iname.includes(q))"></div>
    <div class="tbl-wrap"><table class="tbl matrix">
      <thead><tr><th>Item</th><th>Unit</th><% services.forEach(sv => { %><th class="r"><%= sv.title %></th><% }) %></tr></thead>
      <tbody>
      <% [...cats, { id: null, name: 'Uncategorised' }].forEach(c => { const its = items.filter(i => (i.category_id || null) === c.id); if (!its.length) return; %>
        <tr class="cat"><td colspan="<%= services.length + 2 %>"><%= c.name %></td></tr>
        <% its.forEach(it => { %>
        <tr data-iname="<%= it.name.toLowerCase() %>" style="<%= it.is_active ? '' : 'opacity:.5' %>"><td><a href="/admin/items/<%= it.id %>/edit"><b><%= it.name %></b></a></td><td class="muted mono"><%= it.unit %></td>
          <% services.forEach(sv => { const v = pmap[it.id + '_' + sv.id]; %><td class="r"><input type="number" step="0.01" min="0" name="p_<%= it.id %>_<%= sv.id %>" value="<%= v ?? '' %>" placeholder="—"></td><% }) %>
        </tr>
        <% }) %>
      <% }) %>
      </tbody>
    </table></div>
    <div class="card-b" style="border-top:1px solid var(--line);display:flex;gap:10px;flex-wrap:wrap;align-items:end">
      <div class="fld"><label>Quick-add item</label><input name="new_item" placeholder="e.g. Silk Scarf"></div>
      <div class="fld"><label>Category</label><select name="new_item_cat"><% cats.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
      <div class="fld"><label>Unit</label><input name="new_item_unit" value="pc" style="width:90px"></div>
    </div>
  </div>
  <div class="sticky-actions"><button class="b dark"><%- icon('check') %>Save price list</button></div>
</form>
<%- include('_bottom') %>
