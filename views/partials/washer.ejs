<%
  // Illustrated front-load washing machine. Params: uid (unique id suffix), img (optional photo inside the door)
  const u = typeof uid !== 'undefined' ? uid : 'w';
  const photo = typeof img !== 'undefined' ? img : '';
%>
<svg class="wm" viewBox="0 0 420 520" role="img" aria-label="Washing machine">
  <defs>
    <linearGradient id="cab-<%= u %>" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset=".55" stop-color="#f3f5f8"/><stop offset="1" stop-color="#e2e7ed"/></linearGradient>
    <linearGradient id="cabSide-<%= u %>" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000" stop-opacity=".06"/><stop offset=".12" stop-color="#000" stop-opacity="0"/><stop offset=".88" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".09"/></linearGradient>
    <linearGradient id="chrome-<%= u %>" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fbfcfd"/><stop offset=".3" stop-color="#c3cbd4"/><stop offset=".5" stop-color="#eef1f4"/><stop offset=".75" stop-color="#9ea9b5"/><stop offset="1" stop-color="#e3e7ec"/></linearGradient>
    <radialGradient id="gasket-<%= u %>" cx=".5" cy=".45" r=".55"><stop offset=".78" stop-color="#2a313c"/><stop offset=".92" stop-color="#3b4350"/><stop offset="1" stop-color="#1a1f27"/></radialGradient>
    <radialGradient id="drum-<%= u %>" cx=".5" cy=".38" r=".7"><stop offset="0" stop-color="#4a5566"/><stop offset=".6" stop-color="#2a3240"/><stop offset="1" stop-color="#131820"/></radialGradient>
    <radialGradient id="tint-<%= u %>" cx=".45" cy=".4" r=".6"><stop offset=".55" stop-color="#0b1424" stop-opacity="0"/><stop offset="1" stop-color="#0b1424" stop-opacity=".55"/></radialGradient>
    <radialGradient id="dial-<%= u %>" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#ffffff"/><stop offset=".6" stop-color="#dfe4ea"/><stop offset="1" stop-color="#b8c1cb"/></radialGradient>
    <pattern id="holes-<%= u %>" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="7" cy="7" r="1.6" fill="#fff" fill-opacity=".09"/></pattern>
    <clipPath id="glass-<%= u %>"><circle cx="210" cy="300" r="100"/></clipPath>
    <filter id="soft-<%= u %>" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="8"/></filter>
  </defs>

  <!-- floor shadow -->
  <ellipse cx="210" cy="494" rx="186" ry="14" fill="#0b1424" opacity=".18" filter="url(#soft-<%= u %>)"/>
  <!-- feet -->
  <rect x="60" y="470" width="40" height="16" rx="4" fill="#8f99a4"/>
  <rect x="320" y="470" width="40" height="16" rx="4" fill="#8f99a4"/>

  <!-- cabinet -->
  <rect x="30" y="20" width="360" height="456" rx="30" fill="url(#cab-<%= u %>)" stroke="#d3d9e0" stroke-width="1.5"/>
  <rect x="30" y="20" width="360" height="456" rx="30" fill="url(#cabSide-<%= u %>)"/>
  <path d="M60 22 H360" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
  <line x1="32" y1="124" x2="388" y2="124" stroke="#d9dfe6" stroke-width="1.5"/>
  <line x1="32" y1="126" x2="388" y2="126" stroke="#fff" stroke-width="1.5"/>

  <!-- detergent drawer -->
  <rect x="56" y="44" width="120" height="56" rx="11" fill="#f6f8fa" stroke="#d1d8df" stroke-width="1.5"/>
  <rect x="72" y="86" width="88" height="7" rx="3.5" fill="#d5dbe2"/>
  <g fill="none" stroke="#a7b1bc" stroke-width="1.3" stroke-linecap="round">
    <path d="M76 58 l5 12 h10 l5 -12"/><path d="M110 56 v14 M104 62 h12"/><circle cx="140" cy="63" r="6"/>
  </g>

  <!-- display -->
  <rect x="192" y="44" width="100" height="56" rx="12" fill="#0e1520"/>
  <rect x="196" y="48" width="92" height="48" rx="9" fill="none" stroke="#1f2a3a"/>
  <text x="242" y="60" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="7" letter-spacing="1.2" fill="#61738c">ECO · 30° · 1200</text>
  <text class="wm-lcd" x="242" y="86" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="21" font-weight="600" fill="#7CF2B4">00<tspan class="wm-colon">:</tspan>42</text>
  <circle cx="206" cy="91" r="2" fill="var(--accent)"/>

  <!-- dial -->
  <g>
    <% for (let i = 0; i < 12; i++) { const a = (i / 12) * Math.PI * 2 - Math.PI / 2; %>
      <circle cx="<%= (340 + Math.cos(a) * 40).toFixed(1) %>" cy="<%= (72 + Math.sin(a) * 40).toFixed(1) %>" r="<%= i === 2 ? 2.6 : 1.6 %>" fill="<%= i === 2 ? 'var(--accent)' : '#b6bfc9' %>"/>
    <% } %>
    <circle cx="340" cy="72" r="31" fill="url(#chrome-<%= u %>)" stroke="#a9b2bc"/>
    <circle cx="340" cy="72" r="24" fill="url(#dial-<%= u %>)"/>
    <g class="wm-knob"><rect x="338" y="52" width="4" height="14" rx="2" fill="#4b5563"/></g>
  </g>
  <!-- buttons -->
  <g>
    <rect x="196" y="106" width="22" height="8" rx="4" fill="#dfe4ea"/><rect x="224" y="106" width="22" height="8" rx="4" fill="#dfe4ea"/>
    <rect x="252" y="106" width="22" height="8" rx="4" fill="var(--accent)" opacity=".9"/>
  </g>

  <!-- hinges -->
  <rect x="64" y="262" width="16" height="26" rx="5" fill="#c3cbd4"/>
  <rect x="64" y="314" width="16" height="26" rx="5" fill="#c3cbd4"/>

  <!-- door -->
  <circle cx="212" cy="305" r="134" fill="#0b1424" opacity=".10" filter="url(#soft-<%= u %>)"/>
  <circle cx="210" cy="300" r="132" fill="url(#chrome-<%= u %>)" stroke="#9aa5b1" stroke-width="1"/>
  <circle cx="210" cy="300" r="121" fill="#d4dbe2"/>
  <circle cx="210" cy="300" r="117" fill="url(#chrome-<%= u %>)" transform="rotate(180 210 300)"/>
  <circle cx="210" cy="300" r="110" fill="url(#gasket-<%= u %>)"/>

  <g clip-path="url(#glass-<%= u %>)">
    <% if (photo) { %>
      <image href="<%= photo %>" x="110" y="200" width="200" height="200" preserveAspectRatio="xMidYMid slice"/>
    <% } else { %>
      <circle cx="210" cy="300" r="100" fill="url(#drum-<%= u %>)"/>
      <circle cx="210" cy="300" r="100" fill="url(#holes-<%= u %>)"/>
      <g class="wm-spin">
        <path d="M150 300 c10 -30 46 -38 62 -18 c14 18 -4 40 -26 44 c-18 4 -42 -6 -36 -26Z" fill="var(--accent)"/>
        <path d="M150 300 c10 -30 46 -38 62 -18" fill="none" stroke="#fff" stroke-opacity=".25" stroke-width="2"/>
        <g transform="translate(222 240) rotate(18)"><path d="M10 0 h18 c0 6 4 9 9 9 c5 0 9 -3 9 -9 h0 l18 8 l-6 16 l-10 -4 v40 h-44 v-40 l-10 4 l-6 -16 Z" transform="scale(.9)" fill="#f7f4ec" stroke="#e2dccd" stroke-width="1.5"/></g>
        <path d="M210 330 c18 -14 52 -10 58 10 c6 20 -18 34 -40 30 c-20 -4 -32 -26 -18 -40Z" fill="#FFD166"/>
        <path d="M168 238 c14 -10 34 -6 36 6 c2 12 -14 20 -28 16 c-12 -4 -16 -14 -8 -22Z" fill="#9AE6B4"/>
        <path d="M244 344 v18 c0 8 6 12 14 12 h12 a6 6 0 0 0 0 -12 h-10 v-18 Z" fill="#fff" stroke="#d9d3c4" stroke-width="1.2"/>
        <path d="M244 344 h16 v6 h-16 Z" fill="var(--accent)"/>
        <path d="M160 346 c6 -10 20 -12 26 -4 l10 14 c4 6 -2 12 -10 10 l-20 -6 c-8 -2 -10 -8 -6 -14Z" fill="var(--primary)" opacity=".9"/>
      </g>
      <g class="wm-water">
        <path class="wm-wave" d="M60 322 q20 -10 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 V420 H60Z" fill="#8ec5ff" fill-opacity=".45"/>
        <path class="wm-wave wm-wave2" d="M60 330 q20 -8 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 V420 H60Z" fill="#5a8dff" fill-opacity=".35"/>
        <g fill="#fff" fill-opacity=".85" class="wm-foam">
          <circle cx="132" cy="322" r="7"/><circle cx="146" cy="318" r="9"/><circle cx="162" cy="322" r="6"/>
          <circle cx="250" cy="318" r="8"/><circle cx="266" cy="322" r="10"/><circle cx="284" cy="320" r="6"/>
        </g>
      </g>
      <% [[150, 3.5, 0], [180, 2.5, 1.1], [214, 4, 2.2], [246, 3, .6], [272, 2.5, 1.7], [196, 2, 3]].forEach(([x, r, d]) => { %>
        <circle class="wm-bubble" cx="<%= x %>" cy="390" r="<%= r %>" fill="#fff" fill-opacity=".25" stroke="#fff" stroke-opacity=".8" style="animation-delay:<%= d %>s"/>
      <% }) %>
    <% } %>
    <circle cx="210" cy="300" r="100" fill="url(#tint-<%= u %>)"/>
    <path d="M136 252 a92 92 0 0 1 96 -48 a78 78 0 0 0 -88 64Z" fill="#fff" fill-opacity=".32"/>
    <path d="M286 330 a84 84 0 0 1 -40 50" stroke="#fff" stroke-opacity=".25" stroke-width="4" fill="none" stroke-linecap="round"/>
  </g>
  <circle cx="210" cy="300" r="100" fill="none" stroke="#0b1018" stroke-width="3"/>

  <!-- handle -->
  <rect x="332" y="276" width="20" height="50" rx="10" fill="url(#chrome-<%= u %>)" stroke="#9aa5b1"/>
  <rect x="338" y="284" width="8" height="34" rx="4" fill="#aab3be"/>

  <!-- kick plate -->
  <line x1="32" y1="446" x2="388" y2="446" stroke="#dbe0e6" stroke-width="1.5"/>
  <rect x="318" y="452" width="46" height="14" rx="5" fill="none" stroke="#c3cbd4" stroke-width="1.5"/>
  <text x="58" y="463" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="2.5" fill="#9aa3ad"><%= String(s.site_name || '').toUpperCase().slice(0, 22) %></text>
</svg>
